<UserControl x:Class="SudokuApp.Controls.BlockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SudokuApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="Black" BorderThickness="1" Padding="5" Width="Auto" Height="Auto">
        <Grid x:Name="BlockGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
            <local:CeilControl Grid.Row="0" Grid.Column="0"/>
            <local:CeilControl Grid.Row="0" Grid.Column="1"/>
            <local:CeilControl Grid.Row="0" Grid.Column="2"/>
            <local:CeilControl Grid.Row="1" Grid.Column="0"/>
            <local:CeilControl Grid.Row="1" Grid.Column="1"/>
            <local:CeilControl Grid.Row="1" Grid.Column="2"/>
            <local:CeilControl Grid.Row="2" Grid.Column="0"/>
            <local:CeilControl Grid.Row="2" Grid.Column="1"/>
            <local:CeilControl Grid.Row="2" Grid.Column="2"/>
            -->
        </Grid>
    </Border>
</UserControl>
