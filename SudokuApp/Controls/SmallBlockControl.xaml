<UserControl x:Class="SudokuApp.Controls.SmallBlockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SudokuApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="Black" BorderThickness="1" Padding="5" Width="100" Height="100">
        <Grid ShowGridLines="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="9" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        </Grid>
    </Border>
</UserControl>
